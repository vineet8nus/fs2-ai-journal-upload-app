{
  "welcomeFile": "/journalui/webapp/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/journal/(.*)$",
      "target": "/journal/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/journalui/(.*)$",
      "target": "/journalui/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    }
  ]
}
